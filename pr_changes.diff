+        v_cond = cond_fn(z, t=0.4)
+        v_uncond = uncond_fn(z, t=0.4)
+        assert v_cond.shape == (5, 768)
+        assert v_uncond.shape == (5, 768)
+        assert v_cond.dtype == np.float32
+        assert v_uncond.dtype == np.float32
