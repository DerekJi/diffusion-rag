-++# ──────────────────────────────────────────────
-++#  CFG 引导
-++# ──────────────────────────────────────────────
-++
-++
-++def cfg_guide(
-++    z_cond: NDArray[np.float32],
-++    z_uncond: NDArray[np.float32],
-++    scale: float = 2.0,
-++) -> NDArray[np.float32]:
